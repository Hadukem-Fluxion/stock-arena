{
  "name": "stock-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Casual games about tokenized stocks for Discord Activities and Telegram Mini Apps, priced from xStocks on Fluxion (Mantle).",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "catalog:generate": "tsx packages/fluxion-oracle/src/catalog-generate.ts",
    "dev": "pnpm --parallel --filter @stock-arena/web --filter @stock-arena/api --filter @stock-arena/worker dev",
    "verify:node": "node scripts/check-node.mjs",
    "start:api": "pnpm verify:node && pnpm --filter @stock-arena/api start",
    "start:worker": "pnpm verify:node && pnpm --filter @stock-arena/worker start",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:web": "pnpm --filter @stock-arena/web build && playwright test --config apps/web/playwright.config.ts",
    "db:generate": "pnpm --filter @stock-arena/db db:generate",
    "db:migrate": "pnpm --filter @stock-arena/db db:migrate",
    "db:seed-quiz": "tsx --env-file-if-exists=.env packages/db/src/seed-quiz.ts",
    "discord:register-commands": "pnpm --filter @stock-arena/api discord:register-commands",
    "telegram:setup": "pnpm --filter @stock-arena/api telegram:setup",
    "oracle:print": "pnpm --filter @stock-arena/fluxion-oracle oracle:print",
    "db:copy-game-content": "tsx packages/db/src/copy-game-content.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.5"
  }
}
