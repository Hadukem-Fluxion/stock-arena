{
  "name": "stock-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Casual games about tokenized stocks for Discord Activities and Telegram Mini Apps, priced from xStocks on Fluxion (Mantle).",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @stock-arena/web --filter @stock-arena/api --filter @stock-arena/worker dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @stock-arena/db db:generate",
    "db:migrate": "pnpm --filter @stock-arena/db db:migrate",
    "oracle:print": "pnpm --filter @stock-arena/fluxion-oracle oracle:print"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.5"
  }
}
