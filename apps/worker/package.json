{
  "name": "@stock-arena/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:production": "node --optimize-for-size ../../node_modules/typescript/bin/tsc -p tsconfig.production.json"
  },
  "dependencies": {
    "@stock-arena/db": "workspace:*",
    "@stock-arena/fluxion-oracle": "workspace:*",
    "@stock-arena/game-core": "workspace:*",
    "drizzle-orm": "0.45.4"
  }
}
