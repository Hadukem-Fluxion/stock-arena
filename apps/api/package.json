{
  "name": "@stock-arena/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "discord:register-commands": "tsx --env-file-if-exists=../../.env src/discord/register-cli.ts",
    "telegram:setup": "tsx --env-file-if-exists=../../.env src/telegram/setup-cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@stock-arena/db": "workspace:*",
    "@stock-arena/game-core": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "^5.1.0",
    "jose": "6.2.12",
    "zod": "^3.23.8",
    "viem": "2.57.7"
  }
}
