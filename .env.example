# Copy to .env and fill in. Never commit .env.

# Database (Supabase Postgres)
DATABASE_URL=postgres://user:password@localhost:5432/stock_arena

# API
API_PORT=8787
SESSION_SECRET=change-me-to-a-long-random-string

# Discord application (Developer Portal > your app)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Telegram bot (from BotFather). Use a separate test bot for development.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_GROUP_ID=

# Mantle + Fluxion
MANTLE_RPC_URL=https://rpc.mantle.xyz
# JSON map from ticker to pool info, provided by the Fluxion team, e.g.
# {"AAPL":{"pool":"0x...","base":"0x...","quote":"0x..."}}
FLUXION_POOLS_JSON={}
PRICE_POLL_SECONDS=15
PRICE_JUMP_LIMIT_PCT=5

# Admins (comma-separated platform user ids)
ADMIN_DISCORD_IDS=
ADMIN_TELEGRAM_IDS=
