# Copy to .env and fill in. Never commit .env.

# Database (Supabase Postgres)
# Leave empty to use local PGlite; set a Postgres URL for Supabase.
DATABASE_URL=
QUIZ_BANK_PATH=
# Optional PEM CA path, relative to the repository root or absolute.
# Defaults to the public Supabase CA shipped with packages/db.
DATABASE_SSL_CA=packages/db/certs/supabase-ca.crt

# API
API_PORT=8787
# Railway sets PORT automatically; leave unset locally to use API_PORT.
# At least 32 bytes of random secret material, entered locally by Hadukem.
SESSION_SECRET=

# Discord application (Developer Portal > your app)
DISCORD_CLIENT_ID=
# Public Ed25519 key from Developer Portal > General Information; API only.
DISCORD_PUBLIC_KEY=
# Public client ID bundled by Vite (same ID as above). Never expose server secrets.
VITE_DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Telegram bot (from BotFather). Use a separate test bot for development.
TELEGRAM_BOT_TOKEN=
# Random 32-256 characters from A-Z, a-z, 0-9, _ and -; API and local setup only.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_GROUP_ID=

# Vercel build-time setting only: Railway API HTTPS origin, without /api.
# Railway service build/start settings are documented in docs/DEPLOY.md.
RAILWAY_API_URL=

# xStocks primary prices + Mantle/Fluxion cross-checks (no API key)
XSTOCKS_API_BASE=https://api.backed.fi/api/v2
MANTLE_RPC_URL=https://rpc.mantle.xyz
# Empty uses the five public pools in assets.ts. An explicit {} disables cross-checks.
# Optional JSON map: ticker -> {pool, base (wrapped xStock), quote (Mantle USDC)}.
FLUXION_POOLS_JSON=
PRICE_DIVERGENCE_PCT=3
PRICE_JUMP_LIMIT_PCT=5

# Admins (comma-separated platform user ids)
ADMIN_DISCORD_IDS=
ADMIN_TELEGRAM_IDS=
